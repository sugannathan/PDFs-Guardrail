# Copy to secrets.env (never committed) and adjust. Without this file, PDFGuard runs rules-only.

# --- Default: free, open Hugging Face model on your own machine (no key, nothing leaves your computer) ---
PDFGUARD_PROVIDER=local
# pip install transformers torch accelerate      (any machine; uses the GPU if there is one)
# pip install mlx-lm                             (Apple Silicon Macs, faster)
# Default model: Qwen/Qwen3-4B-Instruct-2507 (transformers) or mlx-community/Qwen3-4B-Instruct-2507-4bit (MLX)
# PDFGUARD_MODEL=Qwen/Qwen3-1.7B                 # smaller / faster
# PDFGUARD_MODEL=google/gemma-3-1b-it            # Gemma is gated: accept the licence on huggingface.co and set HF_TOKEN
# HF_TOKEN=

# --- Alternative: Cerebras API (gpt-oss-120b) ---
# PDFGUARD_PROVIDER=cerebras
# CEREBRAS_API_KEY=
# PDFGUARD_RPM=20

# --- Alternative: Hugging Face Inference Providers API (needs credits) ---
# PDFGUARD_PROVIDER=huggingface
# HF_TOKEN=
